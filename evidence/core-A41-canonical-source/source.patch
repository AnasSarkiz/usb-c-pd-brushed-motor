+  if (interpolationMode !== "quadratic") {
+    return startWidth + (endWidth - startWidth) * fraction
+  }
+  const ascendingFraction = startWidth <= endWidth ? fraction : 1 - fraction
+  return (
+    Math.min(startWidth, endWidth) +
+    Math.abs(endWidth - startWidth) * ascendingFraction ** 2
+  )
