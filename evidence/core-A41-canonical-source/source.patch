+/** Match Circuit JSON's monotonic width profile; no coordinate transform. */
+function getInterpolatedFixedWidth({
+  startWidth,
+  endWidth,
+  interpolationMode,
+  fraction,
+}: {
+  startWidth: number
+  endWidth: number
+  interpolationMode?: "linear" | "quadratic"
+  fraction: number
