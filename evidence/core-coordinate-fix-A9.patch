diff --git a/lib/utils/format-pcb-display-offset.ts b/lib/utils/format-pcb-display-offset.ts
new file mode 100644
index 0000000..1158858
--- /dev/null
+++ b/lib/utils/format-pcb-display-offset.ts
@@ -0,0 +1,7 @@
+// PCB offsets are displacements in their parent anchor frame: +X right,
+// +Y top. Resolved numeric distances are millimeters; expressions stay text.
+export function formatPcbDisplayOffset(
+  offset: number | string | undefined,
+): string | undefined {
+  return typeof offset === "number" ? `${offset}mm` : offset
+}
