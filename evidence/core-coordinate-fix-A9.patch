diff --git a/tests/components/pcb/pcb-position-display-offset-schema.test.tsx b/tests/components/pcb/pcb-position-display-offset-schema.test.tsx
new file mode 100644
index 0000000..fa81eac
--- /dev/null
+++ b/tests/components/pcb/pcb-position-display-offset-schema.test.tsx
@@ -0,0 +1,110 @@
+import { expect, test } from "bun:test"
+import { any_circuit_element } from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("explicit PCB component and group offsets conform to Circuit JSON without changing placement", () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={40} height={30} routingDisabled schematicDisabled>
+      <resistor
+        name="R_NUMBER"
+        resistance="1k"
+        footprint="0402"
+        pcbX={2}
+        pcbY={-2}
+      />
+      <resistor
+        name="R_UNIT"
+        resistance="1k"
+        footprint="0402"
+        pcbX="0.2cm"
+        pcbY="3mm"
+      />
+      <resistor name="R_X_ONLY" resistance="1k" footprint="0402" pcbX={5} />
+      <resistor name="R_Y_ONLY" resistance="1k" footprint="0402" pcbY={6} />
+      <resistor
+        name="R_CALC"
+        resistance="1k"
+        footprint="0402"
+        pcbX="calc(R_NUMBER.x + 6mm)"
+        pcbY="-2mm"
+      />
+      <resistor
+        name="R_EDGE"
+        resistance="1k"
+        footprint="0402"
+        pcbLeftEdgeX="calc(board.minX + 2mm)"
+        pcbY={-8}
+      />
+      <group name="G_NUMBER" subcircuit pcbX={10} pcbY={10}>
+        <resistor
+          name="R_CHILD"
+          resistance="1k"
+          footprint="0402"
+          pcbX={1}
+          pcbY={1}
+        />
+      </group>
+      <group
+        name="G_ANCHOR"
+        subcircuit
+        pcbX={-10}
+        pcbY={10}
+        pcbPositionAnchor="center"
+      >
+        <resistor name="R_ANCHOR" resistance="1k" footprint="0402" />
+      </group>
+    </board>,
+  )
+  circuit.render()
+  const output = circuit.getCircuitJson()
+  // Parse the emitted document, without rewriting metadata or relaxing its schema.
+  for (const element of output)
+    expect(
+      any_circuit_element.safeParse(element).success,
+      JSON.stringify(element),
+    ).toBe(true)
+  const sourceByName = new Map(
+    circuit.db.source_component
+      .list()
+      .map((source) => [source.name, source.source_component_id]),
+  )
+  const components = new Map(
+    circuit.db.pcb_component
+      .list()
+      .map((component) => [component.source_component_id, component]),
+  )
+  const component = (name: string) => {
+    const sourceId = sourceByName.get(name)
+    const placed = sourceId ? components.get(sourceId) : undefined
+    if (!placed) throw new Error(`Missing PCB component ${name}`)
+    return placed
+  }
+  expect(component("R_NUMBER").center).toEqual({ x: 2, y: -2 })
+  expect(component("R_NUMBER").display_offset_x).toBe("2mm")
+  expect(component("R_NUMBER").display_offset_y).toBe("-2mm")
+  expect(component("R_UNIT").center).toEqual({ x: 2, y: 3 })
+  expect(component("R_UNIT").display_offset_x).toBe("2mm")
+  expect(component("R_X_ONLY").display_offset_x).toBe("5mm")
+  expect(component("R_X_ONLY").display_offset_y).toBeUndefined()
+  expect(component("R_Y_ONLY").display_offset_x).toBeUndefined()
+  expect(component("R_Y_ONLY").display_offset_y).toBe("6mm")
+  expect(component("R_CALC").center.x).toBeCloseTo(8)
+  expect(component("R_CALC").display_offset_x).toBe("8mm")
+  const edge = component("R_EDGE")
+  expect(edge.center.x - edge.width / 2).toBeCloseTo(-18)
+  expect(Number.parseFloat(edge.display_offset_x ?? "")).toBeCloseTo(
+    edge.center.x,
+  )
+  expect(component("R_CHILD").center).toEqual({ x: 11, y: 11 })
+  for (const group of circuit.db.pcb_group.list()) {
+    if (group.name === "G_NUMBER") {
+      expect(group.display_offset_x).toBe("10mm")
+      expect(group.display_offset_y).toBe("10mm")
+    }
+    if (group.name === "G_ANCHOR") {
+      expect(group.display_offset_x).toBe("-10mm")
+      expect(group.display_offset_y).toBe("10mm")
+    }
+  }
+})
