@@ -0,0 +1,56 @@
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { FanoutSolver } from "../lib/fanout-solver"
+import type { SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import type { FanoutSolverOptions } from "../lib/types"
+const input: {
+  simpleRouteJson: SimpleRouteJson
+  solverOptions: FanoutSolverOptions
+} = await Bun.file("tests/fixtures/dataset31-imx6ull-top-center.json").json()
+const solver = new FanoutSolver(input.simpleRouteJson, input.solverOptions)
+solver.solve()
+if (!solver.solved) throw new Error(String(solver.error))
+const output = solver.getOutput()
+await Bun.write(
+  "../../evidence/fanout-source-fix-A22/imx6ull-current.svg",
+  getSvgFromGraphicsObject(solver.visualize()),
+)
+const issues: object[] = []
+for (const trace of output.fanoutTraces) {
+  let previous: { x: number; y: number; layer: string } | undefined
+  let vector: { x: number; y: number } | undefined
+  for (const [pointIndex, point] of trace.route.entries()) {
+    if (point.route_type !== "wire") {
+      previous = undefined
+      vector = undefined
+      continue
+    }
+    if (previous?.layer === point.layer) {
+      const next = { x: point.x - previous.x, y: point.y - previous.y }
+      if (Math.hypot(next.x, next.y) > 1e-7) {
+        if (vector) {
+          const dot = vector.x * next.x + vector.y * next.y
+          const cross = Math.abs(vector.x * next.y - vector.y * next.x)
+          if (!(dot >= -1e-7 && (cross < 1e-7 || Math.abs(cross - dot) < 1e-7)))
+            issues.push({
+              connection: trace.connection_name,
+              pointIndex,
+              dot,
+              cross,
+              previous,
+              point,
+              vector,
+              next,
+              route: trace.route,
+            })
+        }
+        vector = next
+      }
+    }
+    previous = point
+  }
+}
+await Bun.write(
+  "../../evidence/fanout-source-fix-A22/imx6ull-corner-diagnosis.json",
+  JSON.stringify(issues, null, 2),
+)
+console.log(issues.map(({ ...issue }) => issue))
diff --git a/scripts/profile-fanout-fixture.ts b/scripts/profile-fanout-fixture.ts
--- /dev/null
+++ b/scripts/profile-fanout-fixture.ts
@@ -0,0 +1,43 @@
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { FanoutSolver } from "../lib/fanout-solver"
+
+const fixture = Bun.argv[2]
+if (!fixture || !/^[a-z0-9-]+$/.test(fixture))
+  throw new Error(
+    "Supply a fixture basename containing letters, digits and hyphens",
+  )
+const input: {
+  simpleRouteJson: ConstructorParameters<typeof FanoutSolver>[0]
+  solverOptions: ConstructorParameters<typeof FanoutSolver>[1]
+} = await Bun.file(
+  new URL(`../tests/fixtures/${fixture}.json`, import.meta.url),
+).json()
+const solver = new FanoutSolver(input.simpleRouteJson, input.solverOptions)
+const maximumDurationMs = Number(Bun.argv[3])
+if (!Number.isFinite(maximumDurationMs) || maximumDurationMs <= 0)
+  throw new Error("Supply a positive profiling duration in milliseconds")
+const deadline = performance.now() + maximumDurationMs
+while (!solver.solved && !solver.failed) {
+  for (
+    let stepIndex = 0;
+    stepIndex < 1000 && !solver.solved && !solver.failed;
+    stepIndex++
+  )
+    solver.step()
+  // Batch native steps so event-loop scheduling does not dominate the profile.
+  await Bun.sleep(0)
+  if (performance.now() >= deadline) {
+    console.error(
+      "Diagnostic deadline expired; no completed solution is accepted",
+    )
+    process.exit(2)
+  }
+}
+if (!solver.solved) throw new Error(String(solver.error))
+const outputPath = `../../evidence/fanout-source-fix-A22/${fixture}-final-stage-native`
+await Bun.write(`${outputPath}.json`, JSON.stringify(solver.getOutput()))
+await Bun.write(
+  `${outputPath}.svg`,
+  getSvgFromGraphicsObject(solver.visualize()),
+)
+console.log(`Solved ${fixture}; retained unmodified native output and image`)
