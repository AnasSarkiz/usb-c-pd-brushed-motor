diff --git a/tests/coincident-path-corner.test.ts b/tests/coincident-path-corner.test.ts
--- /dev/null
+++ b/tests/coincident-path-corner.test.ts
@@ -0,0 +1,77 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { normalizeLayeredPath } from "lib/normalize-layered-path"
+import { coalesceLayeredPathPoints } from "lib/coalesce-layered-path-points"
+import { fanoutSegmentsHaveValidTurns } from "lib/fanout-segments-have-valid-turns"
+
+test("coincident vertices cannot conceal a sharp copper corner", () => {
+  const points = [
+    { x: 0, y: 1, z: 0 },
+    { x: 0, y: 0, z: 0 },
+    { x: 1e-15, y: 0, z: 0 },
+    { x: 1, y: 0, z: 0 },
+    { x: 2, y: 1, z: 0 },
+  ]
+  const original = structuredClone(points)
+  expect(
+    fanoutSegmentsHaveValidTurns(
+      points.slice(1).map((end, index) => ({
+        start: points[index]!,
+        end,
+        layer: "top",
+        width: 0.08,
+      })),
+    ),
+  ).toBe(false)
+  const normalized = normalizeLayeredPath({
+    points: coalesceLayeredPathPoints(points),
+    chamfer: 0.1,
+    segmentIsClear: () => true,
+  })
+  expect(normalized).not.toBeNull()
+  if (!normalized) throw new Error("Expected a clear normalized path")
+  for (let index = 1; index < normalized.length - 1; index++) {
+    const a = normalized[index - 1]!,
+      b = normalized[index]!,
+      c = normalized[index + 1]!
+    const incoming = { x: b.x - a.x, y: b.y - a.y },
+      outgoing = { x: c.x - b.x, y: c.y - b.y }
+    const cosine =
+      (incoming.x * outgoing.x + incoming.y * outgoing.y) /
+      (Math.hypot(incoming.x, incoming.y) * Math.hypot(outgoing.x, outgoing.y))
+    expect(Number.isFinite(cosine)).toBe(true)
+    expect(cosine).toBeGreaterThanOrEqual(Math.SQRT1_2 - 1e-7)
+  }
+  expect(
+    fanoutSegmentsHaveValidTurns(
+      normalized.slice(1).map((end, index) => ({
+        start: normalized[index]!,
+        end,
+        layer: "top",
+        width: 0.08,
+      })),
+    ),
+  ).toBe(true)
+  expect(normalized[0]).toEqual(points[0])
+  expect(normalized.at(-1)).toEqual(points.at(-1))
+  expect(points).toEqual(original)
+  const transitionPoints = [
+    { x: 0, y: 0, z: 0 },
+    { x: 1, y: 0, z: 0 },
+    { x: 1, y: 0, z: 1 },
+    { x: 2, y: 0, z: 1 },
+  ]
+  expect(coalesceLayeredPathPoints(transitionPoints)).toEqual(transitionPoints)
+  const transition = normalizeLayeredPath({
+    points: coalesceLayeredPathPoints(transitionPoints),
+    chamfer: 0.1,
+    segmentIsClear: () => true,
+  })
+  expect(transition).toHaveLength(4)
+  expect(
+    getSvgFromGraphicsObject({
+      lines: [{ points: normalized, strokeColor: "red", strokeWidth: 0.08 }],
+      points: normalized.map((point) => ({ ...point, color: "blue" })),
+    }),
+  ).toMatchSvgSnapshot(import.meta.path)
+})
