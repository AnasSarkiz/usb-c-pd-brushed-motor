+++ b/tests/plane-ground-drill-clearance.test.ts
@@ -0,0 +1,54 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { FanoutSolver } from "lib/fanout-solver"
+import { distance, distancePointToObstacle } from "lib/geometry"
+import { validateRoutedCopperDrc } from "lib/validate-routed-copper-drc"
+
+// Unmodified native solver input from a placed QFN board. Board-world mm,
+// +X right/+Y up. The plane stage explicitly permits same-net copper joins.
+test("merged QFN ground escapes preserve ordinary drill and pad clearances", async () => {
+  const args: ConstructorParameters<typeof FanoutSolver> = await Bun.file(
+    new URL("./fixtures/plane-ground-clearance.json", import.meta.url),
+  ).json()
+  const solver = new FanoutSolver(args[0], {
+    ...args[1],
+    allowSameNetMerges: true,
+  })
+  solver.solve()
+  expect(solver.failed).toBe(false)
+  const output = solver.getOutput()
+  expect(output.planeTerminations).toHaveLength(5)
+  const vias = output.planeTerminations.map((termination) => termination.via)
+  for (const [firstIndex, firstVia] of vias.entries()) {
+    for (const secondVia of vias.slice(firstIndex + 1)) {
+      const drillGapMm =
+        distance(firstVia.center, secondVia.center) -
+        (firstVia.holeDiameter + secondVia.holeDiameter) / 2
+      expect(drillGapMm).toBeGreaterThanOrEqual(0.25 - 1e-9)
+    }
+    for (const obstacle of args[0].obstacles) {
+      if (
+        !obstacle.componentId ||
+        !obstacle.layers.some((layer) => firstVia.spanLayers.includes(layer))
+      )
+        continue
+      expect(
+        distancePointToObstacle(firstVia.center, obstacle) -
+          firstVia.diameter / 2,
+      ).toBeGreaterThanOrEqual(0.2 - 1e-9)
+    }
+  }
+  const drc = validateRoutedCopperDrc({
+    inputSrj: args[0],
+    // Audit the five newly emitted routes of this plane phase. The thirteen
+    // retained signal prefixes are inputs from a preceding phase, whose
+    // connection declarations are deliberately absent from this phase SRJ.
+    routedSrj: { ...output.simpleRouteJson, traces: output.fanoutTraces },
+    clearance: 0.2,
+    allowBlindAndBuriedVias: false,
+  })
+  expect(drc).toMatchObject({ valid: true, issues: [] })
+  expect(getSvgFromGraphicsObject(solver.visualize())).toMatchSvgSnapshot(
+    import.meta.path,
+  )
+})
diff --git a/tests/same-net-drill-drc.test.ts b/tests/same-net-drill-drc.test.ts
--- /dev/null
+++ b/tests/same-net-drill-drc.test.ts
@@ -0,0 +1,83 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { validateRoutedCopperDrc } from "lib/validate-routed-copper-drc"
+import type { SimpleRouteJsonWithViaDrillRules } from "lib/via-drills-are-clear"
+import { visualizeSimpleRouteJson } from "lib/visualize-simple-route-json"
+
+// Board-world mm: two distinct 0.3 mm holes on GND have only 0.2 mm gap.
+test("the independent copper audit rejects same-net drill spacing", () => {
+  const inputSrj: SimpleRouteJsonWithViaDrillRules = {
+    bounds: { minX: -1, maxX: 3, minY: -2, maxY: 2 },
+    layerCount: 2,
+    minTraceWidth: 0.2,
+    minViaHoleEdgeToViaHoleEdgeClearance: 0.25,
+    obstacles: [],
+    connections: [
+      {
+        name: "GND",
+        pointsToConnect: [
+          { x: 0, y: 0, layer: "top" },
+          { x: 2.5, y: 0, layer: "top" },
+        ],
+      },
+    ],
+  }
+  const routedSrj: SimpleRouteJsonWithViaDrillRules = {
+    ...inputSrj,
+    traces: [0, 1].map((index) => ({
+      type: "pcb_trace" as const,
+      pcb_trace_id: `ground-${index}`,
+      connection_name: "GND",
+      route: [
+        {
+          route_type: "wire" as const,
+          x: index * 2.5,
+          y: 0,
+          layer: "top",
+          width: 0.2,
+        },
+        {
+          route_type: "wire" as const,
+          x: 1 + index * 0.5,
+          y: 0,
+          layer: "top",
+          width: 0.2,
+        },
+        {
+          route_type: "via" as const,
+          x: 1 + index * 0.5,
+          y: 0,
+          from_layer: "top",
+          to_layer: "bottom",
+          via_diameter: 0.6,
+          via_hole_diameter: 0.3,
+        },
+        {
+          route_type: "wire" as const,
+          x: 1 + index * 0.5,
+          y: 0,
+          layer: "bottom",
+          width: 0.2,
+        },
+        {
+          route_type: "wire" as const,
+          x: 1 + index * 0.5,
+          y: -0.8,
+          layer: "bottom",
+          width: 0.2,
+        },
+      ],
+    })),
+  }
+  expect(
+    validateRoutedCopperDrc({
+      inputSrj,
+      routedSrj,
+      clearance: 0.2,
+      allowBlindAndBuriedVias: false,
+    }),
+  ).toMatchObject({ valid: false, issues: [{ code: "via_drill_clearance" }] })
+  expect(
+    getSvgFromGraphicsObject(visualizeSimpleRouteJson(routedSrj)),
+  ).toMatchSvgSnapshot(import.meta.path)
+})
diff --git a/tests/shared-via-drill-identity.test.ts b/tests/shared-via-drill-identity.test.ts
--- /dev/null
+++ b/tests/shared-via-drill-identity.test.ts
@@ -0,0 +1,97 @@
+import { expect, test } from "bun:test"
+import { prepareFanoutBuses } from "lib/prepare-buses"
+import {
+  createFanoutPlanClearanceValidator,
+  fanoutPlansAreClear,
+} from "lib/route-bus"
+import { buildViaMinimalWindingPlan } from "lib/route-via-minimal-winding"
+import {
+  type SimpleRouteJsonWithViaDrillRules,
+  viaDrillsAreClear,
+} from "lib/via-drills-are-clear"
+
+test("shared immutable vias are not separate drills while distinct same-net holes retain clearance", () => {
+  const bounds = { minX: -3, maxX: 3, minY: -3, maxY: 3 }
+  const srj: SimpleRouteJsonWithViaDrillRules = {
+    bounds,
+    layerCount: 2,
+    minTraceWidth: 0.2,
+    minViaHoleEdgeToViaHoleEdgeClearance: 0.25,
+    connections: [
+      {
+        name: "GND",
+        pointsToConnect: [{ x: 0, y: 0, layer: "top", pcb_port_id: "P1" }],
+      },
+    ],
+    obstacles: [
+      {
+        type: "rect",
+        center: { x: 0, y: 0 },
+        width: 0.4,
+        height: 0.4,
+        layers: ["top"],
+        connectedTo: ["GND", "P1"],
+        componentId: "U1",
+        obstacleId: "P1",
+      },
+    ],
+  }
+  const bus = prepareFanoutBuses(srj, {
+    sharedBoundary: bounds,
+    buses: [
+      {
+        busId: "ground",
+        sourceComponentId: "U1",
+        connectionNames: ["GND"],
+        direction: "up",
+        termination: { type: "plane", layer: "bottom" },
+      },
+    ],
+  })[0]!
+  const viaPoint = { x: 0, y: 1.5 }
+  const plan = buildViaMinimalWindingPlan({
+    layerNames: ["top", "bottom"],
+    traceWidth: 0.2,
+    viaDiameter: 0.6,
+    viaHoleDiameter: 0.3,
+    bus,
+    terminal: {
+      connection: bus.connections[0]!,
+      viaPoint,
+      exitPoint: viaPoint,
+    },
+    targetLayer: "bottom",
+    targetLayerPoints: [viaPoint],
+    sourceEscapePoints: [{ x: 0, y: 0 }, viaPoint],
+    allowBlindAndBuriedVias: false,
+  })
+  const rules = {
+    srj,
+    sharedBoundary: bounds,
+    clearance: 0.2,
+    allowBlindAndBuriedVias: false,
+    allowSameNetMerges: true,
+  }
+  const cached = createFanoutPlanClearanceValidator(rules)
+  expect(
+    viaDrillsAreClear({ srj, firstVia: plan.via!, secondVia: plan.via! }),
+  ).toBe(true)
+  expect(cached([plan, plan])).toBe(true)
+  expect(fanoutPlansAreClear({ ...rules, plans: [plan, plan] })).toBe(true)
+  // Sharing a net, coordinates or all geometry never identifies separate objects.
+  for (const center of [viaPoint, { x: 0.5, y: 1.5 }]) {
+    const replacement = { ...plan, via: { ...plan.via!, center } }
+    expect(
+      viaDrillsAreClear({
+        srj,
+        firstVia: plan.via!,
+        secondVia: replacement.via,
+      }),
+    ).toBe(false)
+    expect(cached([plan, replacement])).toBe(false)
+    expect(fanoutPlansAreClear({ ...rules, plans: [plan, replacement] })).toBe(
+      false,
+    )
+  }
+  expect(cached([plan, plan])).toBe(true)
+})
diff --git a/tests/source-origin-accepted-prefix.test.ts b/tests/source-origin-accepted-prefix.test.ts
--- /dev/null
+++ b/tests/source-origin-accepted-prefix.test.ts
@@ -0,0 +1,131 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { buildOutputSimpleRouteJson } from "lib/build-output"
+import { prepareFanoutBuses } from "lib/prepare-buses"
+import { routeReservedViaBusesSteps } from "lib/route-reserved-via-buses"
+import { prepareSourceOriginReservations } from "lib/route-source-origin-buses"
+import { validateRoutedCopperDrc } from "lib/validate-routed-copper-drc"
+import type { SimpleRouteJsonWithViaDrillRules } from "lib/via-drills-are-clear"
+import { visualizeSimpleRouteJson } from "lib/visualize-simple-route-json"
+import { expectSvgSnapshotWithActual } from "./fixtures/expect-svg-snapshot-with-actual"
+
+test("source-origin finalization retains an accepted plane without reserving its drill twice", async () => {
+  const bounds = { minX: -3, maxX: 3, minY: -3, maxY: 3 }
+  const rules = {
+    traceWidth: 0.1,
+    clearance: 0.1,
+    viaDiameter: 0.3,
+    viaHoleDiameter: 0.15,
+  }
+  const layerNames = ["top", "inner1", "inner2", "bottom"]
+  const sources = [-0.5, 0.5, 1.5].map((y) => ({ x: -2, y }))
+  const srj: SimpleRouteJsonWithViaDrillRules = {
+    bounds,
+    layerCount: 4,
+    minTraceWidth: 0.1,
+    minViaHoleEdgeToViaHoleEdgeClearance: 0.15,
+    connections: sources.map((source, index) => ({
+      name: `N${index}`,
+      pointsToConnect: [
+        {
+          ...source,
+          layer: "top",
+          pointId: `P${index}`,
+          pcb_port_id: `P${index}`,
+        },
+        ...(index < 2 ? [{ x: 3, y: source.y, layer: "inner1" }] : []),
+      ],
+    })),
+    obstacles: sources.map((center, index) => ({
+      type: "rect",
+      center,
+      width: 0.3,
+      height: 0.3,
+      componentId: "U1",
+      obstacleId: `P${index}`,
+      layers: ["top"],
+      connectedTo: [`N${index}`, `P${index}`],
+    })),
+  }
+  const allBuses = prepareFanoutBuses(srj, {
+    sharedBoundary: bounds,
+    buses: [
+      {
+        busId: "signals",
+        sourceComponentId: "U1",
+        connectionNames: ["N0", "N1"],
+        direction: "right",
+        preferredExit: "right",
+        allowedLayers: ["inner1"],
+      },
+      {
+        busId: "plane",
+        sourceComponentId: "U1",
+        connectionNames: ["N2"],
+        direction: "right",
+        termination: { type: "plane", layer: "inner2" },
+      },
+    ],
+  })
+  const source = prepareSourceOriginReservations({
+    ...rules,
+    srj,
+    buses: allBuses,
+    layerNames,
+  })!
+  expect(source).not.toBeNull()
+  const bus = allBuses.find((bus) => bus.busId === "signals")!
+  const acceptedPlans = source.sourcePlans.filter(
+    (plan) => plan.termination.type === "plane",
+  )
+  expect(acceptedPlans).toHaveLength(1)
+  const before = JSON.stringify({ srj, source, allBuses, acceptedPlans })
+  const steps = routeReservedViaBusesSteps({
+    ...rules,
+    srj,
+    allBuses,
+    buses: [bus],
+    targetLayer: "inner1",
+    transitLayers: ["inner1"],
+    layerNames,
+    ...source,
+    acceptedPlans,
+    routeFromSourcePads: true,
+    sourceLayerTravelCost: 2,
+    maximumIterations: 300_000,
+    terminals: bus.connections.map((connection) => ({
+      connection,
+      viaPoint: source.fixedViaPointsByConnectionIndex.get(
+        connection.connectionIndex,
+      )!,
+      exitPoint: { x: 3, y: connection.targetPoint.y },
+    })),
+  })
+  let next = steps.next()
+  while (!next.done) next = steps.next()
+  expect(next.value).not.toBeNull()
+  expect(next.value).toHaveLength(2)
+  expect(JSON.stringify({ srj, source, allBuses, acceptedPlans })).toBe(before)
+  const outputSrj = buildOutputSimpleRouteJson({
+    inputSrj: srj,
+    plans: [...acceptedPlans, ...next.value!],
+    layerNames,
+  })
+  expect(
+    validateRoutedCopperDrc({
+      inputSrj: srj,
+      routedSrj: outputSrj,
+      clearance: 0.1,
+      allowBlindAndBuriedVias: false,
+    }),
+  ).toMatchObject({
+    valid: true,
+    checkedTraceCount: 3,
+    checkedViaCount: 3,
+    issues: [],
+  })
+  await expectSvgSnapshotWithActual(
+    getSvgFromGraphicsObject(visualizeSimpleRouteJson(outputSrj)),
+    import.meta.path,
+  )
+})
