--- /dev/null
+++ b/lib/coalesce-layered-path-points.ts
@@ -0,0 +1,19 @@
+import { distance } from "./geometry"
+import type { LayeredPathPoint } from "./normalize-layered-path"
+
+/** Final-path cleanup in board-world mm; retain exact terminals and layer changes. */
+export function coalesceLayeredPathPoints(
+  points: readonly LayeredPathPoint[],
+): LayeredPathPoint[] {
+  const coalesced: LayeredPathPoint[] = []
+  for (const [pointIndex, point] of points.entries()) {
+    const previous = coalesced.at(-1)
+    if (previous?.z === point.z && distance(previous, point) < 1e-7) {
+      if (pointIndex === points.length - 1)
+        coalesced[coalesced.length - 1] = point
+      continue
+    }
+    coalesced.push(point)
+  }
+  return coalesced
+}
diff --git a/lib/fanout-segments-have-valid-turns.ts b/lib/fanout-segments-have-valid-turns.ts
--- /dev/null
+++ b/lib/fanout-segments-have-valid-turns.ts
@@ -0,0 +1,40 @@
+import { distance } from "./geometry"
+import type { RoutedSegment } from "./types"
+
+/** Zero-length same-layer segments must not conceal the next real copper turn. */
+export function fanoutSegmentsHaveValidTurns(
+  segments: readonly RoutedSegment[],
+): boolean {
+  const epsilon = 1e-7
+  let previousVector:
+    | { dx: number; dy: number; length: number; layer: string }
+    | undefined
+  for (const [index, segment] of segments.entries()) {
+    const previousSegment = segments[index - 1]
+    if (previousSegment) {
+      if (distance(previousSegment.end, segment.start) > epsilon) return false
+      if (previousSegment.layer !== segment.layer) previousVector = undefined
+    }
+    const dx = segment.end.x - segment.start.x
+    const dy = segment.end.y - segment.start.y
+    const length = Math.hypot(dx, dy)
+    if (
+      Math.min(
+        Math.abs(dx),
+        Math.abs(dy),
+        Math.abs(Math.abs(dx) - Math.abs(dy)),
+      ) > epsilon
+    )
+      return false
+    if (length < epsilon) continue
+    if (
+      previousVector?.layer === segment.layer &&
+      (previousVector.dx * dx + previousVector.dy * dy) /
+        (previousVector.length * length) <
+        Math.SQRT1_2 - epsilon
+    )
+      return false
+    previousVector = { dx, dy, length, layer: segment.layer }
+  }
+  return true
+}
