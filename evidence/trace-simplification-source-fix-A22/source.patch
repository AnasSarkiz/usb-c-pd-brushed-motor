diff --git a/tests/solvers/trace-simplification-preserves-duplicate-route-pieces.test.ts b/tests/solvers/trace-simplification-preserves-duplicate-route-pieces.test.ts
new file mode 100644
index 0000000..17fd5dd
--- /dev/null
+++ b/tests/solvers/trace-simplification-preserves-duplicate-route-pieces.test.ts
@@ -0,0 +1,50 @@
+import { expect, test } from "bun:test"
+import { ConnectivityMap } from "circuit-json-to-connectivity-map"
+import { TraceSimplificationSolver } from "lib/solvers/TraceSimplificationSolver/TraceSimplificationSolver"
+import type { HighDensityRoute } from "lib/types/high-density-types"
+test("duplicate connection names preserve every physical route piece and reject missing or changed endpoints", () => {
+  const routes: HighDensityRoute[] = [0, 1].map((z) => ({
+    connectionName: "split_connection",
+    rootConnectionName: "net0",
+    traceThickness: 0.2,
+    viaDiameter: 0.6,
+    route: [
+      { x: 0, y: z, z },
+      { x: 2, y: z, z },
+    ],
+    vias: [],
+  }))
+  for (const fault of ["none", "missing", "changed"] as const) {
+    const solver = new TraceSimplificationSolver({
+      hdRoutes: structuredClone(routes),
+      obstacles: [],
+      connMap: new ConnectivityMap({ net0: ["split_connection"] }),
+      colorMap: {},
+      defaultViaDiameter: 0.6,
+      layerCount: 2,
+      preserveRouteEndpoints: true,
+    })
+    if (fault === "missing") solver.hdRoutes.pop()
+    if (fault === "changed") solver.hdRoutes[1]!.route[0]!.x = 0.3
+    if (fault === "none") {
+      solver.solve()
+      expect(solver.failed).toBeFalse()
+      expect(solver.simplifiedHdRoutes).toHaveLength(2)
+      for (const route of routes) {
+        const output = solver.simplifiedHdRoutes.find(
+          (r) => r.route[0]?.z === route.route[0]?.z,
+        )
+        expect(output?.route[0]).toEqual(route.route[0])
+        expect(output?.route.at(-1)).toEqual(route.route.at(-1))
+      }
+    } else {
+      expect(() => solver.solve()).toThrow(
+        fault === "missing" ? "preserved route set" : "preserved endpoint",
+      )
+      expect(solver.failed).toBeTrue()
+      expect(solver.error).toContain(
+        fault === "missing" ? "preserved route set" : "preserved endpoint",
+      )
+    }
+  }
+})
