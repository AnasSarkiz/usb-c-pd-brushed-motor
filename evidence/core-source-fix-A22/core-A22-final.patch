@@ -0,0 +1,25 @@
+import { expect, test } from "bun:test"
+import { any_circuit_element, pcb_hole } from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("standalone mounting holes omit an absent component association", () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width="30mm" height="20mm" routingDisabled>
+      <hole diameter="3.2mm" pcbX={-10} pcbY={5} />
+      <hole shape="rect" width="2mm" height="1mm" pcbX={10} pcbY={5} />
+      <hole shape="oval" width="3mm" height="1mm" pcbX={-10} pcbY={-5} />
+      <hole shape="pill" width="3mm" height="1mm" pcbX={10} pcbY={-5} />
+      <pcbnotetext text="Four native NPTH mounting holes" pcbY={0} />
+    </board>,
+  )
+  circuit.render()
+  expect(circuit.db.pcb_hole.list()).toHaveLength(4)
+  for (const hole of circuit.db.pcb_hole.list()) {
+    expect(hole.pcb_component_id).toBeUndefined()
+    pcb_hole.parse(hole)
+  }
+  for (const element of circuit.getCircuitJson())
+    any_circuit_element.parse(element)
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
diff --git a/tests/components/primitive-components/board-plated-hole-solder-paste.test.tsx b/tests/components/primitive-components/board-plated-hole-solder-paste.test.tsx
new file mode 100644
index 0000000..c572acd
--- /dev/null
+++ b/tests/components/primitive-components/board-plated-hole-solder-paste.test.tsx
@@ -0,0 +1,90 @@
+import { expect, test } from "bun:test"
+import { any_circuit_element, type LayerRef } from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("plated-hole assembly layers preserve copper and SMT stencil apertures", () => {
+  for (const selection of [
+    undefined,
+    "both",
+    "top",
+    "bottom",
+    "none",
+  ] as const) {
+    const { circuit } = getTestFixture()
+    circuit.add(
+      <board
+        width={24}
+        height={12}
+        routingDisabled
+        pcbPlatedHoleSolderPaste={selection}
+        manualEdits={{
+          pcb_placements: [{ selector: "R1", center: { x: 0, y: -3 } }],
+        }}
+      >
+        <platedhole
+          shape="circle"
+          outerDiameter={2}
+          holeDiameter={1}
+          pcbX={-6}
+        />
+        <platedhole
+          shape="pill"
+          outerWidth={2}
+          outerHeight={3}
+          holeWidth={1}
+          holeHeight={2}
+          pcbX={0}
+          pcbRotation={90}
+        />
+        <platedhole
+          shape="oval"
+          outerWidth={2}
+          outerHeight={3}
+          holeWidth={1}
+          holeHeight={2}
+          pcbX={6}
+        />
+        <resistor name="R1" resistance="1k" footprint="0402" />
+        <pcbnotetext
+          text={`Plated-hole paste: ${selection ?? "legacy both"}; SMT unchanged`}
+          pcbY={4}
+          fontSize={0.5}
+        />
+      </board>,
+    )
+    circuit.render()
+    const holes = circuit.db.pcb_plated_hole.list()
+    expect(holes).toHaveLength(3)
+    expect(circuit.db.pcb_smtpad.list()).toHaveLength(2)
+    const expectedLayers: LayerRef[] =
+      selection === "none"
+        ? []
+        : selection === "top"
+          ? ["top"]
+          : selection === "bottom"
+            ? ["bottom"]
+            : ["top", "bottom"]
+    for (const hole of holes) {
+      expect(hole.layers).toEqual(["top", "bottom"])
+      expect(
+        circuit.db.pcb_solder_paste
+          .list()
+          .filter((paste) => paste.x === hole.x && paste.y === hole.y)
+          .map((paste) => paste.layer),
+      ).toEqual(expectedLayers)
+    }
+    expect(
+      circuit.db.pcb_solder_paste.list().filter((paste) => paste.y === -3),
+    ).toHaveLength(2)
+    for (const element of circuit.getCircuitJson()) {
+      expect(
+        any_circuit_element.safeParse(element).success,
+        JSON.stringify(element),
+      ).toBe(true)
+    }
+    if (selection === "none")
+      expect(circuit).toMatchPcbSnapshot(import.meta.path, {
+        showSolderPaste: true,
+      })
+  }
+})
diff --git a/tests/components/primitive-components/board-silkscreen-schema.test.tsx b/tests/components/primitive-components/board-silkscreen-schema.test.tsx
new file mode 100644
index 0000000..57e4259
--- /dev/null
+++ b/tests/components/primitive-components/board-silkscreen-schema.test.tsx
@@ -0,0 +1,41 @@
+import { expect, test } from "bun:test"
+import { any_circuit_element, pcb_silkscreen_text } from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("standalone board labels use the native board artwork association", () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board
+      width="30mm"
+      height="20mm"
+      routingDisabled
+      manualEdits={{
+        pcb_placements: [{ selector: "R1", center: { x: 8, y: 0 } }],
+      }}
+    >
+      <silkscreentext text="TOP BOARD LABEL" layers={["top"]} pcbY={4} />
+      <silkscreentext text="BOTTOM BOARD LABEL" layers={["bottom"]} pcbY={-4} />
+      <resistor name="R1" resistance="1k" footprint="0603" />
+    </board>,
+  )
+  circuit.render()
+  const boardLabels = circuit.db.pcb_silkscreen_text
+    .list()
+    .filter((label) => label.text.endsWith("BOARD LABEL"))
+  expect(boardLabels.map((label) => label.layer)).toEqual(["top", "bottom"])
+  for (const label of boardLabels) {
+    expect(label.pcb_component_id).toBe(
+      circuit.db.pcb_board.list()[0].pcb_board_id,
+    )
+    pcb_silkscreen_text.parse(label)
+  }
+  expect(
+    circuit.db.pcb_silkscreen_text.list().find((label) => label.text === "R1")
+      ?.pcb_component_id,
+  ).toBe(circuit.db.pcb_component.list()[0].pcb_component_id)
+  for (const element of circuit.getCircuitJson()) {
+    const parsed = any_circuit_element.safeParse(element)
+    expect(parsed.success, JSON.stringify(element)).toBe(true)
+  }
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
diff --git a/tests/components/primitive-components/custom-symbol-rotation.test.tsx b/tests/components/primitive-components/custom-symbol-rotation.test.tsx
new file mode 100644
index 0000000..cb4eb79
--- /dev/null
+++ b/tests/components/primitive-components/custom-symbol-rotation.test.tsx
@@ -0,0 +1,79 @@
+import { test, expect } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("custom symbol rotation moves graphics, electrical pins and facing together", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board
+      width={24}
+      height={10}
+      routingDisabled
+      schLayout={{ layoutMode: "relative" }}
+    >
+      {[0, 90, 180, 270, -90].map((ccwRotationDegrees, index) => (
+        <chip
+          key={ccwRotationDegrees}
+          name={`U${index + 1}`}
+          schX={index * 4}
+          schY={3}
+          schRotation={ccwRotationDegrees}
+          symbol={
+            <symbol>
+              <schematicrect schX={0} schY={0} width={0.4} height={0.2} />
+              <schematiccircle center={{x:0.2,y:0.1}} radius={0.05} />
+              <schematicarc
+                center={{ x: 0, y: 0 }}
+                radius={0.3}
+                startAngleDegrees={0}
+                endAngleDegrees={90}
+              />
+              <schematicpath
+                points={[
+                  { x: -0.5, y: -0.25 },
+                  { x: 0.5, y: 0 },
+                  { x: -0.5, y: 0.25 },
+                ]}
+              />
+              <schematictext text="+" schX={0.3} schY={0.2} fontSize={0.15} />
+              <port
+                name="A"
+                pinNumber={1}
+                schX={1}
+                schY={0}
+                direction="right"
+              />
+              <port
+                name="K"
+                pinNumber={2}
+                schX={-1}
+                schY={0}
+                direction="left"
+              />
+            </symbol>
+          }
+        />
+      ))}
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const ports = circuit.db.schematic_port.list()
+  const expected = [
+    { x: 1, y: 3, direction: "right" },
+    { x: 4, y: 4, direction: "up" },
+    { x: 7, y: 3, direction: "left" },
+    { x: 12, y: 2, direction: "down" },
+    { x: 16, y: 2, direction: "down" },
+  ] as const
+  for (const [index, position] of expected.entries()) {
+    const port = ports.filter((p) => p.pin_number === 1)[index]!
+    expect(port.center.x).toBeCloseTo(position.x, 8)
+    expect(port.center.y).toBeCloseTo(position.y, 8)
+    expect(port.facing_direction).toBe(position.direction)
+    const path = circuit.db.schematic_path.list()[index]!
+    expect(path.points[1]!.x).toBeCloseTo((port.center.x + index * 4) / 2, 8)
+    expect(path.points[1]!.y).toBeCloseTo((port.center.y + 3) / 2, 8)
+  }
+  expect(circuit).toMatchSchematicSnapshot(import.meta.path, {
+    drawPorts: true,
+  })
+})
