+import { expect, test } from "bun:test"
+import type { Port } from "lib/components/primitive-components/Port"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+test("custom JSX symbol resolves the same physical PCB port through routing selectors", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={20} height={20} routingDisabled>
+      <chip
+        name="Q1"
+        pinLabels={{ pin1: ["B"], pin2: ["E"], pin3: ["C"] }}
+        symbol={
+          <symbol name="body">
+            <port
+              name="pin2"
+              pinNumber={2}
+              aliases={["E"]}
+              direction="down"
+              schX={0.2}
+              schY={-0.4}
+            />
+            <port
+              name="pin1"
+              pinNumber={1}
+              aliases={["B"]}
+              direction="left"
+              schX={-0.2}
+              schY={0}
+            />
+            <port
+              name="pin3"
+              pinNumber={3}
+              aliases={["C"]}
+              direction="up"
+              schX={0.2}
+              schY={0.4}
+            />
+          </symbol>
+        }
+        footprint="sot23"
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const port = (circuit.selectAll("port") as Port[]).find(
+    (p) => p.props.name === "pin1",
+  )!
+  const selected = circuit.selectOne(port.getPortSelector(), {
+    type: "port",
+  }) as Port | null
+  const all = circuit.selectAll("port") as Port[]
+
+  const physicalPorts = all.filter(
+    (p) => p.pcb_port_id === selected?.pcb_port_id,
+  )
+  expect(port.getPortSelector()).toBe(".Q1 > symbol.body > port.pin1")
+  expect(selected?.pcb_port_id).toBeDefined()
+  expect(selected).toBe(physicalPorts.at(-1) ?? null)
+})
diff --git a/tests/features/supplier-circuit-json-cache.test.ts b/tests/features/supplier-circuit-json-cache.test.ts
new file mode 100644
index 0000000..72e459b
--- /dev/null
+++ b/tests/features/supplier-circuit-json-cache.test.ts
@@ -0,0 +1,84 @@
+import { expect, test } from "bun:test"
+import type { LocalCacheEngine, PartsEngine } from "@tscircuit/props"
+import type { AnyCircuitElement } from "circuit-json"
+import { getSupplierCircuitJson } from "lib/utils/get-supplier-circuit-json"
+
+type SupplierCacheKey = Parameters<LocalCacheEngine["getItem"]>[0]
+test("supplier cache deduplicates concurrent calls, expires success, and propagates failures", async () => {
+  const entries = new Map<SupplierCacheKey, string>()
+  const localCacheEngine: LocalCacheEngine = {
+    getItem: async (key) => entries.get(key) ?? null,
+    setItem: async (key, entry) => {
+      entries.set(key, entry)
+    },
+  }
+  const elements: AnyCircuitElement[] = [
+    {
+      type: "pcb_smtpad",
+      pcb_smtpad_id: "supplier_pad",
+      shape: "circle",
+      x: 0,
+      y: 0,
+      radius: 1,
+      layer: "top",
+    },
+  ]
+  let fetchCalls = 0
+  let fail = false
+  const partsEngine: PartsEngine = {
+    findPart: () => ({ jlcpcb: ["C1"] }),
+    fetchPartCircuitJson: async () => {
+      fetchCalls++
+      await Promise.resolve()
+      if (fail) throw new Error("Supplier rejected request")
+      return elements
+    },
+  }
+  const request = {
+    partsEngine,
+    supplierName: "jlcpcb" as const,
+    supplierPartNumber: "C1",
+    localCacheEngine,
+  }
+  const [first, second] = await Promise.all([
+    getSupplierCircuitJson(request),
+    getSupplierCircuitJson(request),
+  ])
+  expect(first).toEqual(elements)
+  expect(second).toEqual(elements)
+  expect(fetchCalls).toBe(1)
+  await getSupplierCircuitJson({ ...request, partsEngine: { ...partsEngine } })
+  expect(fetchCalls).toBe(1)
+  entries.set(
+    "supplier-circuit-json:v1:jlcpcb:C1",
+    JSON.stringify({ fetchedAtMs: Date.now() - 86400001, elements }),
+  )
+  await getSupplierCircuitJson(request)
+  expect(fetchCalls).toBe(2)
+  entries.set(
+    "supplier-circuit-json:v1:jlcpcb:C1",
+    JSON.stringify({ fetchedAtMs: Date.now() + 10000, elements }),
+  )
+  await getSupplierCircuitJson(request)
+  expect(fetchCalls).toBe(3)
+  entries.set(
+    "supplier-circuit-json:v1:jlcpcb:C1",
+    '{"elements":[{"type":"invalid"}]}',
+  )
+  await expect(getSupplierCircuitJson(request)).rejects.toThrow()
+  expect(fetchCalls).toBe(3)
+  entries.clear()
+  fail = true
+  await expect(getSupplierCircuitJson(request)).rejects.toThrow(
+    "Supplier rejected request",
+  )
+  await expect(getSupplierCircuitJson(request)).rejects.toThrow(
+    "Supplier rejected request",
+  )
+  expect(fetchCalls).toBe(5)
+  expect(entries.size).toBe(0)
+  fail = false
+  await getSupplierCircuitJson({ ...request, supplierPartNumber: "C2" })
+  expect(fetchCalls).toBe(6)
+  expect(entries.has("supplier-circuit-json:v1:jlcpcb:C2")).toBe(true)
+})
diff --git a/tests/repros/repro-routed-net-piece-attribution.test.tsx b/tests/repros/repro-routed-net-piece-attribution.test.tsx
new file mode 100644
index 0000000..4498ce9
--- /dev/null
+++ b/tests/repros/repro-routed-net-piece-attribution.test.tsx
@@ -0,0 +1,63 @@
+import { expect, test } from "bun:test"
+import {
+  checkDanglingTraces,
+  checkEachPcbPortConnectedToPcbTraces,
+} from "@tscircuit/checks"
+import type { SimplifiedPcbTrace } from "lib/utils/autorouting/SimpleRouteJson"
+import { getSourceTraceIdForRoutedTrace } from "lib/components/primitive-components/Group/get-source-trace-id-for-routed-trace"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("interior router pieces retain net ownership without concealing disconnected copper", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={20} height={20} routingDisabled>
+      <resistor
+        name="R1"
+        footprint="0603"
+        resistance="1k"
+        pcbX={-4}
+        connections={{ pin1: "net.SIGNAL" }}
+      />
+      <resistor
+        name="R2"
+        footprint="0603"
+        resistance="1k"
+        pcbX={4}
+        connections={{ pin1: "net.SIGNAL" }}
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const net = circuit.db.source_net.list().find((net) => net.name === "SIGNAL")!
+  const piece: SimplifiedPcbTrace = {
+    type: "pcb_trace",
+    pcb_trace_id: "interior_piece",
+    connection_name: net.source_net_id,
+    route: [
+      { route_type: "wire", x: -1, y: 3, width: 0.2, layer: "bottom" },
+      { route_type: "wire", x: 1, y: 3, width: 0.2, layer: "bottom" },
+    ],
+  }
+  const sourceTraceId = getSourceTraceIdForRoutedTrace({
+    db: circuit.db,
+    trace: piece,
+  })
+  expect(sourceTraceId).toBeDefined()
+  expect(
+    circuit.db.source_trace.get(sourceTraceId!)?.connected_source_net_ids,
+  ).toContain(net.source_net_id)
+  const copper = [
+    ...circuit.getCircuitJson(),
+    { ...piece, source_trace_id: sourceTraceId },
+  ]
+  expect(checkDanglingTraces(copper)).toHaveLength(2)
+  expect(
+    checkEachPcbPortConnectedToPcbTraces(copper).length,
+  ).toBeGreaterThanOrEqual(2)
+  expect(
+    getSourceTraceIdForRoutedTrace({
+      db: circuit.db,
+      trace: { ...piece, connection_name: "unknown_net" },
+    }),
+  ).toBeUndefined()
+})
