diff --git a/tests/breakout.test.ts b/tests/breakout.test.ts
index 4f26146..21d0118 100644
--- a/tests/breakout.test.ts
+++ b/tests/breakout.test.ts
@@ -120,3 +120,21 @@ test("should parse breakout point offsets and position mode", () => {
   expect(parsed.pcbOffsetY).toBeCloseTo(3)
   expect(parsed.pcbPositionMode).toBe("relative_to_board_anchor")
 })
+
+test("breakout point preserves an explicit physical target layer", () => {
+  expect(
+    breakoutPointProps.parse({ connection: "U1.pin1", layer: "bottom" }),
+  ).toHaveProperty("layer", "bottom")
+  expect(
+    breakoutPointProps.parse({
+      connection: "U1.pin1",
+      layer: { name: "inner1" },
+    }),
+  ).toHaveProperty("layer", "inner1")
+  expect(
+    breakoutPointProps.parse({ connection: "U1.pin1" }),
+  ).not.toHaveProperty("layer")
+  expect(() =>
+    breakoutPointProps.parse({ connection: "U1.pin1", layer: "invalid" }),
+  ).toThrow()
+})
