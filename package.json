{
  "name": "@tsci/AnasSarkiz.usb-c-pd-brushed-motor",
  "version": "0.0.1",
  "description": "USB-C PD brushed motor controller engineering prototype; hardware qualification pending",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "cloud:setup": "bash scripts/codex/setup.sh",
    "cloud:route": "bash scripts/codex/route.sh",
    "cloud:context": "python3 scripts/codex/verify-context.py",
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --pcb-png --pcb-svgs --schematic-svgs",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:preroute": "tsci check netlist index.circuit.tsx && tsci check pin_specification index.circuit.tsx && tsci check source index.circuit.tsx && tsci check schematic-placement index.circuit.tsx && tsci check placement index.circuit.tsx",
    "power:report": "bun scripts/power-report.ts",
    "firmware:bringup": "bun scripts/build-firmware.ts bringup",
    "firmware:qualified": "bun scripts/build-firmware.ts qualified",
    "test": "bun test ./tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tscircuit/cli": "0.1.2402",
    "@types/bun": "1.4.2",
    "tscircuit": "0.0.3008",
    "typescript": "5.9.3"
  },
  "author": "AnasSarkiz",
  "private": true,
  "dependencies": {
    "@tscircuit/capacity-autorouter": "0.0.1003",
    "@tscircuit/core": "0.0.2199",
    "@tscircuit/props": "0.0.709",
    "circuit-json": "0.0.534"
  },
  "packageManager": "bun@1.4.2"
}
